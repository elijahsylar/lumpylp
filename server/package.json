{
  "name": "lumpylp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "index": "node indexer/index.js",
    "testdb:start": "test/db/start-test-mysql.sh",
    "testdb:stop": "test/db/stop-test-mysql.sh",
    "test:setup": "node test/db/setup.js --quiet",
    "test": "node test/db/setup.js --quiet && node --test --test-concurrency=1 --test-timeout=60000 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "perf:setup": "node test/db/setup.js --db=lumpylp_scale_test --tracks=650000",
    "perf": "node test/perf/perf.js --runs=30"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

# LumpyLP environment template. Copy to .env (local dev) or
# server/.env.production (server) and fill in real values there.
# Never put real values in this file: it is tracked in git.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Database (local dev: a local MySQL; production: the managed MySQL,
# which requires TLS via DB_SSL_CA).
DB_HOST=localhost
DB_PORT=3306
DB_USER=<db user>
DB_PASS=<db password>
DB_NAME=lumpylp
DB_SSL_CA=

# Long random string; rotate to sign everyone out.
JWT_SECRET=<random secret>

# Source API credentials (indexer only).
JAMENDO_CLIENT_ID=<jamendo client id>
AUDIUS_APP_NAME=LumpyLP
AUDIUS_BEARER_TOKEN=<audius bearer token>

FMA_API_BASE=https://freemusicarchive.org/api

# Voluntary support: a Stripe Payment Link that unlocks nothing. Must be https.
SUPPORT_URL=<https payment link>

# Cloudflare Turnstile for signup. Without a secret, signup is refused.
TURNSTILE_SITE_KEY=<turnstile site key>
TURNSTILE_SECRET_KEY=<turnstile secret key>

# Public origin, used for CORS (the SPA is same-origin, so this is optional).
PUBLIC_URL=https://lumpylp.com

# Which proxies may set X-Forwarded-For (client IPs for rate limits).
TRUST_PROXY=loopback

# Optional per-limit overrides, e.g. {"login": 20}. See server/lib/rateLimits.js.
RATE_LIMITS=

# Contact address sent in the indexer's User-Agent (Wikimedia and others
# require one). Default: takedowns@lumpylp.com
INDEXER_CONTACT_EMAIL=<contact email>
